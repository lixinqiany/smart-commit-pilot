{
  "name": "smart-commit-pilot",
  "displayName": "Smart Git Pilot",
  "description": "%extension.description%",
  "version": "0.3.0",
  "publisher": "michael-yu",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lixinqiany/smart-commit-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/lixinqiany/smart-commit-pilot/issues"
  },
  "keywords": [
    "git",
    "commit",
    "AI",
    "blame",
    "conventional commits"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "smart-commit-pilot.setup",
        "title": "%commands.setup%",
        "category": "Smart Git Pilot"
      },
      {
        "command": "smart-commit-pilot.generateCommitMessage",
        "title": "%commands.generateCommitMessage%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/scm-icon-light.svg",
          "dark": "images/scm-icon-dark.svg"
        }
      },
      {
        "command": "smart-commit-pilot.composeCommits",
        "title": "%commands.composeCommits%",
        "category": "Smart Git Pilot",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "smart-commit-pilot.configurePrompt",
        "title": "%commands.configurePrompt%",
        "category": "Smart Git Pilot"
      },
      {
        "command": "smart-commit-pilot.selectModel",
        "title": "%commands.selectModel%",
        "category": "Smart Git Pilot"
      },
      {
        "command": "smart-commit-pilot.toggleLineBlame",
        "title": "%commands.toggleLineBlame%",
        "category": "Smart Git Pilot"
      },
      {
        "command": "smart-commit-pilot.branches.switch",
        "title": "%branches.switch%",
        "category": "Smart Git Pilot",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "smart-commit-pilot.branches.create",
        "title": "%branches.create%",
        "category": "Smart Git Pilot",
        "icon": "$(add)"
      },
      {
        "command": "smart-commit-pilot.branches.refresh",
        "title": "%branches.refresh%",
        "category": "Smart Git Pilot",
        "icon": "$(refresh)"
      },
      {
        "command": "smart-commit-pilot.branches.switchTo",
        "title": "%branches.switchTo%",
        "category": "Smart Git Pilot",
        "icon": "$(arrow-swap)",
        "enablement": "viewItem =~ /^pilotBranch/"
      },
      {
        "command": "smart-commit-pilot.branches.fetch",
        "title": "%branches.fetch%",
        "category": "Smart Git Pilot",
        "icon": "$(cloud-download)",
        "enablement": "viewItem =~ /Fetchable$/"
      },
      {
        "command": "smart-commit-pilot.branches.createFrom",
        "title": "%branches.createFrom%",
        "category": "Smart Git Pilot",
        "icon": "$(add)"
      },
      {
        "command": "smart-commit-pilot.branches.delete",
        "title": "%branches.delete%",
        "category": "Smart Git Pilot",
        "icon": "$(trash)"
      },
      {
        "command": "smart-commit-pilot.branches.local",
        "title": "%branches.local%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/local-idle.svg",
          "dark": "images/branches/local-idle.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.localActive",
        "title": "%branches.localActive%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/local-on-light.svg",
          "dark": "images/branches/local-on-dark.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.remote",
        "title": "%branches.remote%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/remote-idle.svg",
          "dark": "images/branches/remote-idle.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.remoteActive",
        "title": "%branches.remoteActive%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/remote-on-light.svg",
          "dark": "images/branches/remote-on-dark.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.addRemote",
        "title": "%branches.addRemote%",
        "category": "Smart Git Pilot",
        "icon": "$(add)"
      },
      {
        "command": "smart-commit-pilot.branches.listLayout",
        "title": "%branches.listLayout%",
        "category": "Smart Git Pilot",
        "icon": "$(list-flat)"
      },
      {
        "command": "smart-commit-pilot.branches.treeLayout",
        "title": "%branches.treeLayout%",
        "category": "Smart Git Pilot",
        "icon": "$(list-tree)"
      },
      {
        "command": "smart-commit-pilot.branches.tags",
        "title": "%branches.tags%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/tags-idle.svg",
          "dark": "images/branches/tags-idle.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.tagsActive",
        "title": "%branches.tagsActive%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/tags-on-light.svg",
          "dark": "images/branches/tags-on-dark.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.contributors",
        "title": "%branches.contributors%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/contributors-idle.svg",
          "dark": "images/branches/contributors-idle.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.contributorsActive",
        "title": "%branches.contributorsActive%",
        "category": "Smart Git Pilot",
        "icon": {
          "light": "images/branches/contributors-on-light.svg",
          "dark": "images/branches/contributors-on-dark.svg"
        }
      },
      {
        "command": "smart-commit-pilot.branches.allContributors",
        "title": "%branches.allContributors%",
        "category": "Smart Git Pilot",
        "icon": "$(git-branch)"
      },
      {
        "command": "smart-commit-pilot.branches.currentContributors",
        "title": "%branches.currentContributors%",
        "category": "Smart Git Pilot",
        "icon": "$(target)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "smart-commit-pilot.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@10"
        },
        {
          "command": "smart-commit-pilot.composeCommits",
          "when": "scmProvider == git",
          "group": "navigation@11"
        }
      ],
      "view/title": [
        {
          "command": "smart-commit-pilot.branches.localActive",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode == local",
          "group": "navigation@1"
        },
        {
          "command": "smart-commit-pilot.branches.local",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode != local",
          "group": "navigation@1"
        },
        {
          "command": "smart-commit-pilot.branches.remote",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode != remote",
          "group": "navigation@2"
        },
        {
          "command": "smart-commit-pilot.branches.remoteActive",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode == remote",
          "group": "navigation@2"
        },
        {
          "command": "smart-commit-pilot.branches.tags",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode != tags",
          "group": "navigation@3"
        },
        {
          "command": "smart-commit-pilot.branches.tagsActive",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode == tags",
          "group": "navigation@3"
        },
        {
          "command": "smart-commit-pilot.branches.contributors",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode != contributors",
          "group": "navigation@4"
        },
        {
          "command": "smart-commit-pilot.branches.contributorsActive",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode == contributors",
          "group": "navigation@4"
        },
        {
          "command": "smart-commit-pilot.branches.refresh",
          "when": "view == smart-commit-pilot.branches",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "smart-commit-pilot.branches.delete",
          "when": "view == smart-commit-pilot.branches && smart-commit-pilot.branches.mode == local && viewItem =~ /^pilotBranch(Fetchable)?$/",
          "group": "2_manage@1"
        },
        {
          "command": "smart-commit-pilot.branches.switchTo",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "navigation@1"
        },
        {
          "command": "smart-commit-pilot.branches.fetch",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "navigation@2"
        },
        {
          "command": "smart-commit-pilot.branches.createFrom",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "navigation@3"
        },
        {
          "command": "smart-commit-pilot.branches.switch",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilotLocal(Tree|List)$/",
          "group": "inline@1"
        },
        {
          "command": "smart-commit-pilot.branches.create",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilotLocal(Tree|List)$/",
          "group": "inline@2"
        },
        {
          "command": "smart-commit-pilot.branches.addRemote",
          "when": "view == smart-commit-pilot.branches && viewItem == pilotRemote",
          "group": "inline@2"
        },
        {
          "command": "smart-commit-pilot.branches.listLayout",
          "when": "view == smart-commit-pilot.branches && viewItem == pilotLocalTree",
          "group": "inline@3"
        },
        {
          "command": "smart-commit-pilot.branches.treeLayout",
          "when": "view == smart-commit-pilot.branches && viewItem == pilotLocalList",
          "group": "inline@3"
        },
        {
          "command": "smart-commit-pilot.branches.refresh",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(LocalTree|LocalList|Remote|Tags|ContributorsAll|ContributorsCurrent)$/",
          "group": "inline@4"
        },
        {
          "command": "smart-commit-pilot.branches.switchTo",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "inline@1"
        },
        {
          "command": "smart-commit-pilot.branches.fetch",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "inline@2"
        },
        {
          "command": "smart-commit-pilot.branches.createFrom",
          "when": "view == smart-commit-pilot.branches && viewItem =~ /^pilot(Current)?Branch(Fetchable)?$/",
          "group": "inline@3"
        },
        {
          "command": "smart-commit-pilot.branches.allContributors",
          "when": "view == smart-commit-pilot.branches && viewItem == pilotContributorsCurrent",
          "group": "inline@1"
        },
        {
          "command": "smart-commit-pilot.branches.currentContributors",
          "when": "view == smart-commit-pilot.branches && viewItem == pilotContributorsAll",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "smart-commit-pilot.branches.delete",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.switchTo",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.fetch",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.createFrom",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.localActive",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.remoteActive",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.listLayout",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.treeLayout",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.tagsActive",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.contributorsActive",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.allContributors",
          "when": "false"
        },
        {
          "command": "smart-commit-pilot.branches.currentContributors",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Smart Git Pilot",
      "properties": {
        "smartCommitPilot.provider": {
          "type": "string",
          "enum": [
            "OpenAI",
            "Anthropic"
          ],
          "default": "OpenAI",
          "description": "%settings.provider%"
        },
        "smartCommitPilot.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%settings.baseUrl%"
        },
        "smartCommitPilot.prompt": {
          "type": "string",
          "default": "",
          "description": "%settings.prompt%"
        },
        "smartCommitPilot.composer.model": {
          "type": "string",
          "default": "",
          "description": "%settings.composer.model%"
        },
        "smartCommitPilot.model": {
          "type": "string",
          "default": "",
          "description": "%settings.model%"
        },
        "smartCommitPilot.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%settings.blame.enabled%"
        },
        "smartCommitPilot.blame.avatars": {
          "type": "boolean",
          "default": true,
          "description": "%settings.blame.avatars%"
        }
      }
    },
    "views": {
      "scm": [
        {
          "id": "smart-commit-pilot.branches",
          "name": "%branches.view%",
          "contextualTitle": "Smart Git Pilot",
          "icon": "images/scm-icon-dark.svg",
          "visibility": "visible"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smart-commit-pilot.branches",
        "contents": "%branches.welcome%"
      }
    ],
    "colors": [
      {
        "id": "smartGitPilot.currentBranchForeground",
        "description": "%branches.currentColor%",
        "defaults": {
          "light": "#16796F",
          "dark": "#82D8C7",
          "highContrast": "foreground",
          "highContrastLight": "foreground"
        }
      }
    ],
    "icons": {
      "smart-git-pilot-current-branch": {
        "description": "%branches.currentIcon%",
        "default": {
          "fontPath": "./images/branches/current-branch.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "keybindings": [
      {
        "command": "smart-commit-pilot.composeCommits",
        "key": "ctrl+k ctrl+shift+g",
        "mac": "cmd+k cmd+shift+g",
        "when": "gitOpenRepositoryCount > 0"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "vsix": "vsce package --no-dependencies",
    "publish:extension": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "openai": "^6.49.0"
  },
  "l10n": "./l10n"
}
